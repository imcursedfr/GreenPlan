# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard. Safe to expose in the
# browser as long as Row Level Security (RLS) is enabled on all tables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── AI (Vercel AI SDK) ─────────────────────────────────────────────────────
# Any OpenAI-compatible gateway works. Never put real keys in files that ship
# to the browser; the centralized AI service routes model traffic through a
# serverless function so the key stays server-side.
VITE_AI_BASE_URL=
VITE_AI_MODEL=
